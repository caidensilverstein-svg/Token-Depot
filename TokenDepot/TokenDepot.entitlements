<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keychain access -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.silversteincapital.tokendepot</string>
	</array>
	<!-- App Sandbox OFF — needed for floating windows + unrestricted file access -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
